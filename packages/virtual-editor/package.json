{
  "name": "@pdf-editor/virtual-editor",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/editor/index.js",
  "module": "./dist/editor/index.mjs",
  "types": "./dist/editor/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.mjs",
      "require": "./dist/editor/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "devDependencies": {
    "@pdf-editor/eslint-config": "workspace:*",
    "@pdf-editor/typescript-config": "workspace:*",
    "@types/node": "^20.11.24",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.2.0",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@pdf-editor/pdf": "workspace:*",
    "@pdf-editor/storage": "workspace:*"
  }
}
