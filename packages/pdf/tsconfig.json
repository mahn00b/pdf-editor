{
    "extends": "@pdf-editor/typescript-config/node-library.json",
    "compilerOptions": {
      "typeRoots": ["typings/", "node_modules/@types"],
      "baseUrl": ".",
      "rootDir": ".",
      "paths": {
        "@core/*": ["src/core/*"],
        "@ops/*": ["src/ops/*"],
        "@query/*": ["src/query/*"],
        "@types/*": ["src/types/*"],
        "@types": ["src/types/index.ts"]
      }
    },
    "includes": ["src", "typings", "./node_modules/@pdf-editor/tsconfig"],
    "exclude": ["node_modules", "dist", "scripts"]
  }